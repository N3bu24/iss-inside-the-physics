{
  "model": "opus",
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.local)"]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/notify.mjs\" --hook Notification",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
